<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>hMailServer</AssemblyName>
    <RootNamespace>HMailServer.Service</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HMailServer.ComInterop\HMailServer.ComInterop.csproj" />
    <ProjectReference Include="..\HMailServer.Core\HMailServer.Core.csproj" />
    <ProjectReference Include="..\HMailServer.Delivery\HMailServer.Delivery.csproj" />
    <ProjectReference Include="..\HMailServer.Indexing\HMailServer.Indexing.csproj" />
    <ProjectReference Include="..\HMailServer.Protocols\HMailServer.Protocols.csproj" />
    <ProjectReference Include="..\HMailServer.Scripting\HMailServer.Scripting.csproj" />
    <ProjectReference Include="..\HMailServer.Storage.SqlServer\HMailServer.Storage.SqlServer.csproj" />
    <ProjectReference Include="..\HMailServer.Search.SqlServer\HMailServer.Search.SqlServer.csproj" />
    <ProjectReference Include="..\HMailServer.Security\HMailServer.Security.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
  </ItemGroup>
  <Target Name="GenerateLegacyTypeLibrary" AfterTargets="Build">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\..\..\..\build\generate-net10-typelib.ps1&quot; -SourceIdl &quot;$(MSBuildProjectDirectory)\..\..\..\Server\hMailServer\hMailServer.idl&quot; -OutputPath &quot;$(TargetDir)hMailServer.tlb&quot;" />
  </Target>
  <Target Name="PublishLegacyTypeLibrary" AfterTargets="Publish">
    <Copy SourceFiles="$(TargetDir)hMailServer.tlb" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
